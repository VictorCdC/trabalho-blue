# Copie para .env antes de subir o ambiente: cp .env.example .env
# O .env não é versionado. Nenhum valor daqui serve para produção.

# ---------------------------------------------------------------- banco
# O banco é o PostgreSQL da máquina, não um contêiner: crie o papel e o banco
# antes de subir o ambiente.
#
#   createuser -P -d blue          # -d porque o pytest cria o banco de teste
#   createdb -O blue blue_dev
#
# As duas URLs apontam para o mesmo banco. Elas existem porque o nome do host
# muda de lado: comando rodado na máquina (alembic, pytest, scripts) chega por
# `localhost`; contêiner do compose chega por `host.docker.internal`, porque lá
# dentro `localhost` é o próprio contêiner.
DATABASE_URL=postgresql+psycopg2://blue:troque-esta-senha@localhost:5432/blue_dev
DATABASE_URL_CONTAINER=postgresql+psycopg2://blue:troque-esta-senha@host.docker.internal:5432/blue_dev

# Banco dos testes. Opcional: sem isto o pytest troca o nome do banco da
# DATABASE_URL acima por `blue_teste` e cria o banco se faltar.
# TEST_DATABASE_URL=postgresql+psycopg2://blue:troque-esta-senha@localhost:5432/blue_teste

# --------------------------------------------------------------- backend
# "desenvolvimento" | "producao". Fora de desenvolvimento o backend exige
# SECRET_KEY própria e cookie seguro.
AMBIENTE=desenvolvimento

# Assina o cookie de sessão. Gere a sua: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=chave-apenas-de-desenvolvimento-nao-use-em-producao

# Cookie de sessão
SESSAO_HORAS=8
COOKIE_SECURE=false

# Login: bloqueio temporário após tentativas erradas (NOME.SOBRENOME é adivinhável)
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Menor número de pessoas que um grupo precisa ter para o agregado ser
# divulgado. Abaixo disso a API responde "grupo pequeno demais" em vez do
# número — sem isto, filtrar unidade+setor+cargo reidentifica alguém.
K_MINIMO_AGREGACAO=5

# Origens autorizadas a chamar a API com cookie (separadas por vírgula)
ORIGENS_PERMITIDAS=http://localhost:3000

# -------------------------------------------------------------- frontend
# Onde a API responde. Precisa ser alcançável pelo navegador, não pela rede
# interna do compose: o fetch sai da máquina do usuário.
NEXT_PUBLIC_API_URL=http://localhost:8000
