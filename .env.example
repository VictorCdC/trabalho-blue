# Copie para .env antes de subir o ambiente: cp .env.example .env
# O .env não é versionado. Nenhum valor daqui serve para produção.

# ---------------------------------------------------------------- banco
POSTGRES_USER=blue
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=blue
# porta exposta no host (o container sempre usa 5432 internamente)
DB_PORTA_HOST=5433
DATABASE_URL=postgresql+psycopg2://blue:troque-esta-senha@db:5432/blue

# --------------------------------------------------------------- backend
# "desenvolvimento" | "producao". Fora de desenvolvimento o backend exige
# SECRET_KEY própria e cookie seguro.
AMBIENTE=desenvolvimento

# Assina o cookie de sessão. Gere a sua: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=chave-apenas-de-desenvolvimento-nao-use-em-producao

# Cookie de sessão
SESSAO_HORAS=8
COOKIE_SECURE=false

# Login: bloqueio temporário após tentativas erradas (NOME.SOBRENOME é adivinhável)
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Menor número de pessoas que um grupo precisa ter para o agregado ser
# divulgado. Abaixo disso a API responde "grupo pequeno demais" em vez do
# número — sem isto, filtrar unidade+setor+cargo reidentifica alguém.
K_MINIMO_AGREGACAO=5

# Origens autorizadas a chamar a API com cookie (separadas por vírgula)
ORIGENS_PERMITIDAS=http://localhost:3000

# -------------------------------------------------------------- frontend
# Onde a API responde. Precisa ser alcançável pelo navegador, não pela rede
# interna do compose: o fetch sai da máquina do usuário.
NEXT_PUBLIC_API_URL=http://localhost:8000
